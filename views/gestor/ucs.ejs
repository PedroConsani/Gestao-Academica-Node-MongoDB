<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unidades Curriculares - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Gestão Curricular</p>
                <h1>Unidades Curriculares</h1>
            </div>
            <a href="/gestor/uc/nova" class="btn btn-primary">+ Nova UC</a>
        </div>

        <!-- Tabela de UCs -->
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Código</th>
                        <th>Créditos</th>
                        <th>Status</th>
                        <th style="text-align: center;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (ucs && ucs.length > 0) { %>
                        <% ucs.forEach(uc => { %>
                            <tr>
                                <td><strong><%= uc.nome %></strong></td>
                                <td><code style="background: var(--bg2); padding: 2px 6px; border-radius: 3px;"><%= uc.codigo %></code></td>
                                <td><span style="background: var(--crimson-bg); padding: 4px 8px; border-radius: 3px; font-weight: 600; color: var(--crimson);"><%= uc.creditos %></span></td>
                                <td>
                                    <span style="padding: 5px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;
                                        <%= uc.ativo ? 'background: var(--success-bg); color: var(--success);' : 'background: var(--danger-bg); color: var(--danger);' %>">
                                        <%= uc.ativo ? 'Ativo' : 'Inativo' %>
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <a href="/gestor/uc/<%= uc._id %>/editar" class="btn btn-primary btn-sm">Editar</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">Nenhuma UC encontrada</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <a href="/gestor/dashboard" class="btn btn-secondary" style="margin-top: 2rem;">Voltar</a>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
