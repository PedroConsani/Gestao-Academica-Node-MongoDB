<h2>Unidades Curriculares</h2>
<a href="/gestor/uc/nova" class="btn btn-primary">+ Nova UC</a>

<table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
    <thead>
        <tr style="background: #f1f3f5;">
            <th style="padding: 10px; text-align: left;">Nome</th>
            <th style="padding: 10px; text-align: left;">Código</th>
            <th style="padding: 10px; text-align: left;">Créditos</th>
            <th style="padding: 10px; text-align: left;">Status</th>
            <th style="padding: 10px; text-align: center;">Ações</th>
        </tr>
    </thead>
    <tbody>
        <% if (ucs && ucs.length > 0) { %>
            <% ucs.forEach(uc => { %>
                <tr style="border-bottom: 1px solid #dee2e6;">
                    <td style="padding: 10px;"><strong><%= uc.nome %></strong></td>
                    <td style="padding: 10px;"><%= uc.codigo %></td>
                    <td style="padding: 10px;"><%= uc.creditos %></td>
                    <td style="padding: 10px;">
                        <span style="padding: 5px 10px; border-radius: 5px; 
                            <%= uc.ativo ? 'background: #d4edda; color: #155724;' : 'background: #f8d7da; color: #721c24;' %>">
                            <%= uc.ativo ? 'Ativo' : 'Inativo' %>
                        </span>
                    </td>
                    <td style="padding: 10px; text-align: center;">
                        <a href="/gestor/uc/<%= uc._id %>/editar" class="btn btn-primary" style="font-size: 12px; padding: 5px 10px;">Editar</a>
                    </td>
                </tr>
            <% }); %>
        <% } else { %>
            <tr>
                <td colspan="5" style="padding: 20px; text-align: center; color: #999;">Nenhuma UC encontrada</td>
            </tr>
        <% } %>
    </tbody>
</table>
