<h2><%= uc ? 'Editar UC' : 'Nova UC' %></h2>

<form method="POST" action="<%= uc ? `/gestor/uc/${uc._id}` : '/gestor/uc' %>">
    <div style="margin-bottom: 15px;">
        <label for="nome">Nome da UC:</label>
        <input type="text" id="nome" name="nome" value="<%= uc ? uc.nome : '' %>" required 
               style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="codigo">Código:</label>
        <input type="text" id="codigo" name="codigo" value="<%= uc ? uc.codigo : '' %>" required 
               style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="creditos">Créditos:</label>
        <input type="number" id="creditos" name="creditos" value="<%= uc ? uc.creditos : 6 %>" step="0.5" 
               style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="descricao">Descrição:</label>
        <textarea id="descricao" name="descricao" 
                  style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px; min-height: 100px;"><%= uc ? uc.descricao || '' : '' %></textarea>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="/gestor/ucs" class="btn btn-secondary">Cancelar</a>
</form>

<style>
    form { max-width: 600px; }
    label { font-weight: bold; display: block; margin-bottom: 5px; }
    input, textarea { font-family: inherit; }
</style>
