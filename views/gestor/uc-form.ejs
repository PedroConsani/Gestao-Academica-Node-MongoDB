<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= uc ? 'Editar' : 'Nova' %> UC - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Gestão Curricular</p>
                <h1><%= uc ? 'Editar UC' : 'Nova UC' %></h1>
            </div>
        </div>

        <div class="card" style="max-width: 700px;">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form method="POST" action="<%= uc ? `/gestor/uc/${uc._id}` : '/gestor/uc' %>">
                <div class="form-group">
                    <label for="nome">Nome da UC *</label>
                    <input type="text" id="nome" name="nome" value="<%= uc ? uc.nome : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="codigo">Código *</label>
                    <input type="text" id="codigo" name="codigo" value="<%= uc ? uc.codigo : '' %>" required 
                           pattern="[A-Z0-9-]+" placeholder="ex: PROG1">
                </div>

                <div class="form-group">
                    <label for="creditos">Créditos *</label>
                    <input type="number" id="creditos" name="creditos" value="<%= uc ? uc.creditos : 6 %>" 
                           min="0" max="100" step="0.5" required>
                </div>

                <div class="form-group">
                    <label for="descricao">Descrição (opcional)</label>
                    <textarea id="descricao" name="descricao" placeholder="Descreva a unidade curricular..."><%= uc ? uc.descricao || '' : '' %></textarea>
                </div>

                <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a href="/gestor/ucs" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
