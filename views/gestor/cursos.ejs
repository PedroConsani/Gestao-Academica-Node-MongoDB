<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursos - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Gestão de Cursos</p>
                <h1>Cursos</h1>
            </div>
            <a href="/gestor/curso/novo" class="btn btn-primary">+ Novo Curso</a>
        </div>

        <!-- Tabela de Cursos -->
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Código</th>
                        <th>Duração (anos)</th>
                        <th>Status</th>
                        <th style="text-align: center;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (cursos && cursos.length > 0) { %>
                        <% cursos.forEach(curso => { %>
                            <tr>
                                <td><strong><%= curso.nome %></strong></td>
                                <td><code style="background: var(--bg2); padding: 2px 6px; border-radius: 3px;"><%= curso.codigo %></code></td>
                                <td><%= curso.duracao_anos %></td>
                                <td>
                                    <span style="padding: 5px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;
                                        <%= curso.ativo ? 'background: var(--success-bg); color: var(--success);' : 'background: var(--danger-bg); color: var(--danger);' %>">
                                        <%= curso.ativo ? 'Ativo' : 'Inativo' %>
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <a href="/gestor/curso/<%= curso._id %>/editar" class="btn btn-primary btn-sm">Editar</a>
                                    <button onclick="toggleCurso('<%= curso._id %>')" class="btn btn-secondary btn-sm">Toggle</button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">Nenhum curso encontrado</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <a href="/gestor/dashboard" class="btn btn-secondary" style="margin-top: 2rem;">Voltar</a>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>

    <script>
    function toggleCurso(id) {
        fetch(`/gestor/curso/${id}/toggle`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
                else alert('Erro ao alternar status do curso');
            })
            .catch(e => alert('Erro: ' + e));
    }
    </script>
</body>
</html>
