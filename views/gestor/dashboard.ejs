<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Gestão Pedagógica</p>
                <h1>Dashboard - Gestor</h1>
            </div>
        </div>

        <!-- Cards de Estatísticas -->
        <div class="cards-grid" style="margin-bottom: 3rem;">
            <div class="card">
                <h3>Cursos</h3>
                <p style="font-size: 2rem; color: var(--crimson); font-weight: bold; margin: 0.5rem 0;"><%= stats.cursos %></p>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Total de cursos</p>
                <a href="/gestor/cursos" class="btn btn-primary" style="margin-top: 1rem;">Gerir Cursos</a>
            </div>

            <div class="card">
                <h3>Unidades Curriculares</h3>
                <p style="font-size: 2rem; color: var(--crimson); font-weight: bold; margin: 0.5rem 0;"><%= stats.ucs %></p>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Total de UCs</p>
                <a href="/gestor/ucs" class="btn btn-primary" style="margin-top: 1rem;">Gerir UCs</a>
            </div>

            <div class="card">
                <h3>Fichas Pendentes</h3>
                <p style="font-size: 2rem; color: var(--danger); font-weight: bold; margin: 0.5rem 0;"><%= stats.fichasPendentes %></p>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Aguardando validação</p>
                <a href="/gestor/fichas?estado=submetida" class="btn btn-primary" style="margin-top: 1rem;">Validar Fichas</a>
            </div>
        </div>

        <!-- Menu Rápido -->
        <div class="card" style="background: var(--info-bg); border-left: 4px solid var(--info);">
            <h3 style="color: var(--info);">Menu Rápido</h3>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem;">
                <a href="/gestor/curso/novo" class="btn btn-success">+ Novo Curso</a>
                <a href="/gestor/uc/nova" class="btn btn-success">+ Nova UC</a>
                <a href="/gestor/plano/novo" class="btn btn-success">+ Novo Plano</a>
            </div>
        </div>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
