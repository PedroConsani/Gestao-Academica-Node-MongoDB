<h2>Dashboard - Gestor Pedagógico</h2>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 20px 0;">
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h3>Cursos</h3>
        <p style="font-size: 32px; font-weight: bold; color: #667eea;"><%= stats.cursos %></p>
        <a href="/gestor/cursos" class="btn btn-primary">Gerir Cursos</a>
    </div>

    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h3>Unidades Curriculares</h3>
        <p style="font-size: 32px; font-weight: bold; color: #764ba2;"><%= stats.ucs %></p>
        <a href="/gestor/ucs" class="btn btn-primary">Gerir UCs</a>
    </div>

    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h3>Fichas Pendentes</h3>
        <p style="font-size: 32px; font-weight: bold; color: #ff6b6b;"><%= stats.fichasPendentes %></p>
        <a href="/gestor/fichas?estado=submetida" class="btn btn-primary">Validar Fichas</a>
    </div>
</div>

<div style="margin-top: 30px; padding: 20px; background: #e7f3ff; border-left: 4px solid #0066cc; border-radius: 5px;">
    <h3 style="color: #0066cc; margin-bottom: 10px;">Menu Rápido</h3>
    <a href="/gestor/curso/novo" class="btn btn-success" style="margin-right: 10px;">+ Novo Curso</a>
    <a href="/gestor/uc/nova" class="btn btn-success" style="margin-right: 10px;">+ Nova UC</a>
    <a href="/gestor/plano/novo" class="btn btn-success">+ Novo Plano</a>
</div>
