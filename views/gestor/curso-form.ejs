<h2><%= curso ? 'Editar Curso' : 'Novo Curso' %></h2>

<form method="POST" action="<%= curso ? `/gestor/curso/${curso._id}` : '/gestor/curso' %>">
    <div style="margin-bottom: 15px;">
        <label for="nome">Nome do Curso:</label>
        <input type="text" id="nome" name="nome" value="<%= curso ? curso.nome : '' %>" required 
               style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="codigo">Código:</label>
        <input type="text" id="codigo" name="codigo" value="<%= curso ? curso.codigo : '' %>" required 
               style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px;">
    </div>

    <div style="margin-bottom: 15px;">
        <label for="descricao">Descrição:</label>
        <textarea id="descricao" name="descricao" 
                  style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px; min-height: 100px;"><%= curso ? curso.descricao || '' : '' %></textarea>
    </div>

    <div style="margin-bottom: 15px;">
        <label for="duracao_anos">Duração (anos):</label>
        <input type="number" id="duracao_anos" name="duracao_anos" value="<%= curso ? curso.duracao_anos : 3 %>" 
               min="1" max="5" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-top: 5px;">
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="/gestor/cursos" class="btn btn-secondary">Cancelar</a>
</form>

<style>
    form { max-width: 600px; }
    label { font-weight: bold; display: block; margin-bottom: 5px; }
    input, textarea { font-family: inherit; }
</style>
