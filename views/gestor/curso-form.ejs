<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= curso ? 'Editar' : 'Novo' %> Curso - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Gestão de Cursos</p>
                <h1><%= curso ? 'Editar Curso' : 'Novo Curso' %></h1>
            </div>
        </div>

        <div class="card" style="max-width: 700px;">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form method="POST" action="<%= curso ? `/gestor/curso/${curso._id}` : '/gestor/curso' %>">
                <div class="form-group">
                    <label for="nome">Nome do Curso *</label>
                    <input type="text" id="nome" name="nome" value="<%= curso ? curso.nome : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="codigo">Código *</label>
                    <input type="text" id="codigo" name="codigo" value="<%= curso ? curso.codigo : '' %>" required 
                           pattern="[A-Z0-9-]+" placeholder="ex: LIC-INFO">
                </div>

                <div class="form-group">
                    <label for="duracao_anos">Duração (anos) *</label>
                    <input type="number" id="duracao_anos" name="duracao_anos" value="<%= curso ? curso.duracao_anos : 3 %>" 
                           min="1" max="5" required>
                </div>

                <div class="form-group">
                    <label for="descricao">Descrição (opcional)</label>
                    <textarea id="descricao" name="descricao" placeholder="Descreva o curso..."><%= curso ? curso.descricao || '' : '' %></textarea>
                </div>

                <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a href="/gestor/cursos" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
