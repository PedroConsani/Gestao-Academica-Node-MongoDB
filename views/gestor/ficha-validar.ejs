<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Validar Ficha - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Validação de Fichas</p>
                <h1>Validar Ficha de Aluno</h1>
            </div>
        </div>

        <!-- Informações do Aluno -->
        <div class="card" style="margin-bottom: 2rem;">
            <h3 style="border-bottom: 2px solid var(--crimson); padding-bottom: 1rem; margin-bottom: 1.5rem;">Informações do Aluno</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div>
                    <p style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; font-weight: 600; margin-bottom: 0.3rem;">Nome</p>
                    <p style="font-size: 1.1rem; font-weight: 600;"><%= ficha.aluno_id.nome %></p>
                </div>
                <div>
                    <p style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; font-weight: 600; margin-bottom: 0.3rem;">Email</p>
                    <p style="font-size: 1.1rem;"><%= ficha.aluno_id.email %></p>
                </div>
                <div>
                    <p style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; font-weight: 600; margin-bottom: 0.3rem;">Curso</p>
                    <p style="font-size: 1.1rem;"><%= ficha.curso_id ? ficha.curso_id.nome : 'N/A' %></p>
                </div>
                <div>
                    <p style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; font-weight: 600; margin-bottom: 0.3rem;">Estado</p>
                    <span style="padding: 5px 10px; border-radius: 4px; font-size: 0.85rem; font-weight: 600; display: inline-block;
                        <%= ficha.estado === 'aprovada' ? 'background: var(--success-bg); color: var(--success);' : 
                            ficha.estado === 'rejeitada' ? 'background: var(--danger-bg); color: var(--danger);' :
                            ficha.estado === 'submetida' ? 'background: var(--info-bg); color: var(--info);' :
                            'background: var(--warning-bg); color: var(--warning);' %>">
                        <%= ficha.estado %>
                    </span>
                </div>
            </div>
        </div>

        <!-- Dados Pessoais -->
        <div class="card" style="margin-bottom: 2rem;">
            <h3 style="border-bottom: 2px solid var(--crimson); padding-bottom: 1rem; margin-bottom: 1.5rem;">Dados Pessoais</h3>
            <div class="table-wrap">
                <table style="font-size: 0.95rem;">
                    <tbody>
                        <tr>
                            <td style="font-weight: 600; width: 30%;">Data de Nascimento</td>
                            <td><%= ficha.data_nascimento ? new Date(ficha.data_nascimento).toLocaleDateString('pt-PT') : 'N/A' %></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 600;">NIF</td>
                            <td><code><%= ficha.nif || 'N/A' %></code></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 600;">Cartão de Cidadão</td>
                            <td><code><%= ficha.cc || 'N/A' %></code></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 600;">Nacionalidade</td>
                            <td><%= ficha.nacionalidade || 'N/A' %></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 600;">Telefone</td>
                            <td><%= ficha.telefone || 'N/A' %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Morada -->
        <div class="card" style="margin-bottom: 2rem;">
            <h3 style="border-bottom: 2px solid var(--crimson); padding-bottom: 1rem; margin-bottom: 1.5rem;">Morada</h3>
            <div class="table-wrap">
                <table style="font-size: 0.95rem;">
                    <tbody>
                        <tr>
                            <td style="font-weight: 600; width: 30%;">Rua/Morada</td>
                            <td><%= ficha.morada || 'N/A' %></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 600;">Código Postal</td>
                            <td><code><%= ficha.codigo_postal || 'N/A' %></code></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 600;">Localidade</td>
                            <td><%= ficha.localidade || 'N/A' %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Decisão (apenas se submetida) -->
        <% if (ficha.estado === 'submetida') { %>
            <div class="card" style="background: var(--info-bg); border-left: 4px solid var(--info);">
                <h3 style="color: var(--info); margin-bottom: 1.5rem;">Decisão sobre a Ficha</h3>
                <form method="POST" action="/gestor/ficha/<%= ficha._id %>/validar">
                    <div class="form-group">
                        <label for="observacoes">Observações *</label>
                        <textarea id="observacoes" name="observacoes" required 
                                  placeholder="Escreva suas observações ou motivos da decisão..."></textarea>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                        <button type="submit" name="acao" value="aprovar" class="btn btn-success">
                            ✓ Aprovar
                        </button>
                        <button type="submit" name="acao" value="rejeitar" class="btn btn-danger">
                            ✗ Rejeitar
                        </button>
                        <a href="/gestor/fichas?estado=submetida" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        <% } else { %>
            <div class="card" style="background: var(--bg2);">
                <p style="color: var(--text-muted); text-align: center; margin: 0;">Esta ficha já foi processada e não pode ser alterada.</p>
                <div style="text-align: center; margin-top: 1.5rem;">
                    <a href="/gestor/fichas" class="btn btn-secondary">Voltar</a>
                </div>
            </div>
        <% } %>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
