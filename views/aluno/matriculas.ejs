<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matrículas - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Gestão Académica</p>
                <h1>Minhas Matrículas</h1>
            </div>
            <a href="/aluno/matricula/nova" class="btn btn-primary">+ Nova Matrícula</a>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Curso</th>
                        <th>Ano Letivo</th>
                        <th>Estado</th>
                        <th>Data Solicitação</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (matriculas && matriculas.length > 0) { %>
                        <% matriculas.forEach(mat => { %>
                            <tr>
                                <td><strong><%= mat.curso_id.nome %></strong></td>
                                <td><%= mat.ano_letivo %></td>
                                <td>
                                    <span style="padding: 5px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;
                                        <%= mat.estado === 'aprovada' ? 'background: var(--success-bg); color: var(--success);' : 
                                            mat.estado === 'rejeitada' ? 'background: var(--danger-bg); color: var(--danger);' :
                                            'background: var(--warning-bg); color: var(--warning);' %>">
                                        <%= mat.estado %>
                                    </span>
                                </td>
                                <td><%= new Date(mat.criado_em).toLocaleDateString('pt-PT') %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 2rem; color: var(--text-muted);">Nenhuma matrícula encontrada</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <a href="/aluno/dashboard" class="btn btn-secondary" style="margin-top: 2rem;">Voltar</a>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
