<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notas - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Meu Desempenho</p>
                <h1>Notas - Detalhes</h1>
            </div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>UC</th>
                        <th>Ano Letivo</th>
                        <th>Época</th>
                        <th style="text-align: center;">Nota</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (notas && notas.length > 0) { %>
                        <% notas.forEach(nota => { %>
                            <tr>
                                <td>
                                    <strong>
                                        <%= nota?.pauta_id?.uc_id?.nome || 'N/A' %>
                                    </strong>
                                </td>
                                <td><%= nota?.pauta_id?.ano_letivo || 'N/A' %></td>
                                <td><%= nota?.pauta_id?.epoca || 'N/A' %></td>

                                <td style="text-align: center;">
                                    <% if (nota.nota_final !== null) { %>
                                        <strong style="font-size: 1.1rem; color: var(--crimson);"><%= nota.nota_final %></strong>
                                    <% } else { %>
                                        <span style="color: var(--text-muted);">Não lançada</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 2rem; color: var(--text-muted);">Nenhuma nota encontrada</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <a href="/aluno/dashboard" class="btn btn-secondary" style="margin-top: 2rem;">Voltar</a>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
