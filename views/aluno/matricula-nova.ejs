<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Matrícula - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Matrículas</p>
                <h1>Solicitar Nova Matrícula</h1>
            </div>
        </div>

        <div class="card" style="max-width: 700px;">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger">
                    <strong>⚠️ Aviso:</strong> <%= error %>
                </div>
                <div style="margin-top: 1rem;">
                    <p style="color: var(--text-muted); font-size: 0.95rem;">
                        Para solicitar uma matrícula, é necessário que sua ficha de aluno seja previamente aprovada.
                    </p>
                    <a href="/aluno/ficha" class="btn btn-primary" style="margin-top: 1rem;">
                        → Ir para Minha Ficha
                    </a>
                </div>
            <% } else { %>
                <form method="POST" action="/aluno/matricula">
                    <div class="form-group">
                        <label for="curso_id">Curso *</label>
                        <select id="curso_id" name="curso_id" required>
                            <option value="">Selecione um curso</option>
                            <% if (cursos) { %>
                                <% cursos.forEach(curso => { %>
                                    <option value="<%= curso._id %>"><%= curso.nome %> (<%= curso.codigo %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="ano_letivo">Ano Letivo *</label>
                        <input type="text" id="ano_letivo" name="ano_letivo" placeholder="ex: 2024/2025" 
                               pattern="\d{4}/\d{4}" required>
                    </div>

                    <div class="form-group">
                        <label for="observacoes_aluno">Observações (opcional)</label>
                        <textarea id="observacoes_aluno" name="observacoes_aluno" 
                                  placeholder="Escreva qualquer observação relevante..."></textarea>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                        <button type="submit" class="btn btn-primary">Solicitar Matrícula</button>
                        <a href="/aluno/matriculas" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            <% } %>
        </div>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
