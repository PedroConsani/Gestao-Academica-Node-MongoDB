<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registar - <%= appName %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            <%= appName %>
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } else { %>
                <a href="/auth/login" style="color: #fff; text-decoration: none;">Login</a>
                <a href="/auth/register" style="color: #fff; text-decoration: none; margin-left: 15px;">Registar</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <div class="card" style="max-width: 450px; margin: 2rem auto;">
            <h2 style="color: var(--crimson); font-family: 'Playfair Display', serif;">Criar Conta</h2>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>
            
            <form method="POST" action="/auth/register">
                <div class="form-group">
                    <label for="nome">Nome Completo</label>
                    <input type="text" id="nome" name="nome" required>
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required>
                </div>

                <div class="form-group">
                    <label for="password_confirm">Confirmar Password</label>
                    <input type="password" id="password_confirm" name="password_confirm" required>
                </div>

                <button type="submit" class="btn btn-primary">Registar</button>
            </form>

            <p style="text-align: center; margin-top: 1.5rem;">
                Já tem conta? <a href="/auth/login">Fazer login aqui</a>
            </p>
        </div>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; <%= new Date().getFullYear() %> <%= appName %></p>
    </footer>
</body>
</html>
