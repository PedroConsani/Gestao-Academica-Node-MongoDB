<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pautas - Sistema Académico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span>🎓</span>
            Sistema Académico
        </a>
        <div class="navbar-user">
            <% if (user) { %>
                <span><strong><%= user.nome %></strong></span>
                <span class="badge"><%= user.role %></span>
                <a href="/logout" style="color: #fff; text-decoration: none; margin-left: 15px;">Logout</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <%- include('../shared/flash'); %>
        <div class="page-header">
            <div>
                <p>Avaliação de Alunos</p>
                <h1>Pautas de Avaliação</h1>
            </div>
            <a href="/funcionario/pauta/nova" class="btn btn-primary">+ Nova Pauta</a>
        </div>

        <!-- Tabela de Pautas -->
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>UC</th>
                        <th>Curso</th>
                        <th>Ano Letivo</th>
                        <th>Época</th>
                        <th style="text-align: center;">Status</th>
                        <th style="text-align: center;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (pautas && pautas.length > 0) { %>
                        <% pautas.forEach(pauta => { %>
                            <tr>
                                <td><strong><%= pauta.uc_id.nome %></strong></td>
                                <td><%= pauta.curso_id.nome %></td>
                                <td><%= pauta.ano_letivo %></td>
                                <td><code style="background: var(--bg2); padding: 2px 6px; border-radius: 3px;"><%= pauta.epoca %></code></td>
                                <td style="text-align: center;">
                                    <span style="padding: 5px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;
                                        <%= pauta.fechada ? 'background: var(--danger-bg); color: var(--danger);' : 'background: var(--success-bg); color: var(--success);' %>">
                                        <%= pauta.fechada ? 'Fechada' : 'Aberta' %>
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <a href="/funcionario/pauta/<%= pauta._id %>/notas" class="btn btn-primary btn-sm">Ver/Editar</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">Nenhuma pauta encontrada</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <a href="/funcionario/dashboard" class="btn btn-secondary" style="margin-top: 2rem;">Voltar</a>
    </div>

    <footer style="text-align: center; padding: 2rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 3rem;">
        <p>&copy; 2026 Sistema Académico</p>
    </footer>
</body>
</html>
