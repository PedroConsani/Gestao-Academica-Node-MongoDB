<h2>Dashboard - Funcionário</h2>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 20px 0;">
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h3>Matrículas Pendentes</h3>
        <p style="font-size: 32px; font-weight: bold; color: #ff6b6b;"><%= stats.pendentes %></p>
        <a href="/funcionario/matriculas?estado=pendente" class="btn btn-primary">Avaliar</a>
    </div>

    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h3>Pautas Abertas</h3>
        <p style="font-size: 32px; font-weight: bold; color: #ffa94d;"><%= stats.pautasAbertas %></p>
        <a href="/funcionario/pautas" class="btn btn-primary">Ver Pautas</a>
    </div>
</div>

<div style="margin-top: 30px; padding: 20px; background: #fff3cd; border-left: 4px solid #ff9800; border-radius: 5px;">
    <h3 style="color: #ff9800; margin-bottom: 10px;">Ações Rápidas</h3>
    <a href="/funcionario/matriculas" class="btn btn-primary" style="margin-right: 10px;">Gerir Matrículas</a>
    <a href="/funcionario/pauta/nova" class="btn btn-success">+ Nova Pauta</a>
</div>
